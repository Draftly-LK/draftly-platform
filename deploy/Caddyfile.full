# Everything on this VPS (docker-compose.vps.yml with WEB_ON_VPS=1).
#
# The app is one origin, so the browser never makes a cross-origin API call.
# Caddy sets X-Forwarded-For itself from the real client address; the landing
# page's rate limit relies on that (TRUST_PROXY=1).
{$DOMAIN} {
	encode zstd gzip

	@backend path /api/* /health/*
	handle @backend {
		reverse_proxy backend:8000
	}

	handle {
		reverse_proxy frontend:3000
	}
}

# Marketing site and pilot-request form.
{$LANDING_DOMAIN} {
	encode zstd gzip
	reverse_proxy landing:4173
}
