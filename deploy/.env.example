# Copy to deploy/.env (git-ignored). Read by build.sh, ship.sh and docker-compose.yml.

# ── Site ──────────────────────────────────────────────────────────────────
# Public hostname. Caddy requests a certificate for it, and the frontend image
# is built with NEXT_PUBLIC_API_BASE_URL=https://<DOMAIN>. Use "localhost" for a local run.
# Vercel + VPS (vps.sh): this is the API's hostname; vps.sh init fills in <ip>.sslip.io.
DOMAIN=app.example.com

# Vercel + VPS only: the frontend's exact origin on Vercel, e.g.
# https://draftly-demo.vercel.app. It becomes the backend's CORS allowlist
# (ALLOWED_ORIGINS) and Clerk's authorized party. Preview URLs will not work.
FRONTEND_ORIGIN=

# vps.sh only. 1 = the frontend and the landing page run on the VPS as well
# (single origin, nothing on Vercel). See README.md, "Everything on one VPS".
WEB_ON_VPS=0
# Hostname of the landing page (WEB_ON_VPS=1). vps.sh init defaults it to
# landing.<DOMAIN>; use a real domain (an A record to this server) for production.
LANDING_DOMAIN=

# ── Images (name:tag; built by build.sh, loaded on the server by ship.sh) ─
FRONTEND_IMAGE=draftly-frontend:demo
BACKEND_IMAGE=draftly-backend:demo
RETRIEVAL_IMAGE=draftly-retrieval:demo
LANDING_IMAGE=draftly-landing:vps

# ── Backend ───────────────────────────────────────────────────────────────
# See README.md "Known limitations" before choosing ENVIRONMENT.
ENVIRONMENT=production
# Neon: pooled URL for the app, direct (un-pooled) URL for Alembic. postgresql+psycopg://...
DATABASE_URL=
DATABASE_URL_DIRECT=
EXTRACTION_PROVIDER=stub
PROVIDER_DATA_APPROVAL=false
PARTY_IDENTIFIER_KEY=
PARTY_BLIND_INDEX_KEY=
API_CURSOR_SIGNING_KEY=

# ── Clerk ─────────────────────────────────────────────────────────────────
CLERK_ISSUER=
CLERK_SECRET_KEY=
CLERK_AUDIENCE=
CLERK_AUTHORIZED_PARTY=
# Build time only (inlined into the frontend bundle).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# ── Gemini (backend extraction, retrieval answering + dense channel) ──────
GEMINI_API_KEY=

# ── Build options ─────────────────────────────────────────────────────────
NEXT_PUBLIC_USE_MOCK_PIPELINE=false
# 1 = embed the corpus during the retrieval image build (spends Gemini credits).
RETRIEVAL_WITH_EMBEDDINGS=0
# Path to the research repo checkout (default: ../draftly next to this repo).
# RETRIEVAL_CONTEXT=/path/to/draftly

# ── Frontend runtime ──────────────────────────────────────────────────────
MULTILINGUAL_LANGUAGE_SUPPORT=true
