{
  // avoid-ai-writing is vendored and follows its upstream conventions.
  "globs": [
    "**/*.md",
    "!node_modules",
    "!frontend/node_modules",
    "!landing-page/node_modules/**",
    "!backend/.venv/**",
    "!frontend/test-results/**",
    "!frontend/playwright-report/**",
    "!.agents/skills/avoid-ai-writing/**",
  ],
  "config": {
    "MD013": false,
  },
}
