{
  // avoid-ai-writing is vendored and follows its upstream conventions.
  // draftly-code-review is ours and is deliberately linted: a parser reads it,
  // so its formatting matters more than most files in this repository.
  "globs": [
    "**/*.md",
    "!node_modules",
    "!frontend/node_modules",
    "!backend/.venv/**",
    "!.agents/skills/avoid-ai-writing/**",
  ],
  "config": {
    "MD013": false,
  },
}
