# Backend Gemini classify → extract pipeline. Copy to .env — never commit secrets.

CONFIDENCE_THRESHOLD=0.55
GEMINI_API_KEY=your-gemini-api-key
# Cheap/fast for type + side classification
GEMINI_CLASSIFY_MODEL=gemini-3.1-flash-lite
# Stronger multimodal model for transcription + field extraction
GEMINI_EXTRACT_MODEL=gemini-2.5-flash

# Frontend → backend
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
# Set true to skip the live pipeline and use filename heuristics only
NEXT_PUBLIC_USE_MOCK_PIPELINE=false
