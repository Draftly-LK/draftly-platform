# Frontend environment — copy to frontend/.env (local only, do not commit secrets)

# ── API ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
NEXT_PUBLIC_USE_MOCK_PIPELINE=false

# ── Clerk ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_ME
CLERK_SECRET_KEY=sk_test_REPLACE_ME
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_OUT_URL=/sign-in

# ── Dev auth bypass (ignored when NODE_ENV=production) ────────────────────
# true  → skip Clerk redirects while developing
# false → require sign-in (default)
AUTH_BYPASS=false
