# ── Database (Neon PostgreSQL) ─────────────────────────────────────────────
# Pooled endpoint — used by the FastAPI app at runtime (PgBouncer)
DATABASE_URL=postgresql+psycopg://user:password@host/db?sslmode=require&channel_binding=require
# Direct endpoint — used by Alembic migrations (must NOT go through a pooler)
DATABASE_URL_DIRECT=postgresql+psycopg://user:password@host-direct/db?sslmode=require&channel_binding=require

# ── Clerk (identity provider) ─────────────────────────────────────────────
# Your Clerk Frontend API URL — shown under API Keys in the dashboard
# e.g. https://clerk.your-domain.com  OR  https://your-app.clerk.accounts.dev
CLERK_ISSUER=https://YOUR_CLERK_FRONTEND_API_URL
# Clerk secret key (sk_test_… or sk_live_…) — never commit
CLERK_SECRET_KEY=sk_test_REPLACE_ME
# Leave blank to accept any audience; set to your app's domain in production
CLERK_AUDIENCE=
# Must match the JWT `azp` claim (fail closed). Comma-separated for more than
# one trusted origin — local work uses both Next default and the review port.
CLERK_AUTHORIZED_PARTY=http://localhost:3000,http://localhost:4310
# Clock-drift tolerance when validating Clerk JWTs, in seconds. A host running
# even a couple of seconds slow rejects every token as "not yet valid (iat)".
# Also widens `exp`, so keep it well under the Clerk session token lifetime.
CLERK_LEEWAY_SECONDS=30

# ── Object storage (storage-service.md) ───────────────────────────────────
# GCS is not S3-compatible and is not reached through an S3 emulation layer.
# Credentials come from Application Default Credentials — never a key file in
# a deployed environment. Locally: gcloud auth application-default login
DRAFTLY_GCS_BUCKET=
DRAFTLY_GCS_PROJECT_ID=
# Checked against the bucket at startup; data residency is an approval item.
DRAFTLY_GCS_LOCATION=asia-southeast1
# Storage counterpart of PROVIDER_DATA_APPROVAL. While false, GCS is refused at
# startup and uploads are refused by the adapter. There is no synthetic escape
# hatch: a matter's uploaded evidence is client material by definition.
DRAFTLY_STORAGE_REAL_DATA_APPROVED=false

# ── Google Cloud ──────────────────────────────────────────────────────────
# Used from Phase 3 (Document AI) onward — leave blank for auth phase
GCP_PROJECT_ID=
GCP_LOCATION=asia-south1
GOOGLE_APPLICATION_CREDENTIALS=
CONFIDENCE_THRESHOLD=0.55

# ── Gemini ────────────────────────────────────────────────────────────────
GEMINI_API_KEY=
GEMINI_CLASSIFY_MODEL=gemini-2.5-flash-lite
GEMINI_EXTRACT_MODEL=gemini-2.5-flash-lite

# ── Document processing ───────────────────────────────────────────────────
# one of: vision-gemini | gemini | stub  (stub is refused outside local/test/ci)
# vision-gemini is the V1 pipeline: Cloud Vision OCR plus Gemini 2.5 Flash-Lite.
EXTRACTION_PROVIDER=stub
# §10A data-protection gate — real (non-synthetic) documents are refused and
# routed to manual review until provider terms are recorded and this is true.
PROVIDER_DATA_APPROVAL=false
RASTER_DPI=200

# ── Source-file ingestion (RTA workflow §6.2) ─────────────────────────────
# one of: filesystem | gcs  (filesystem is refused outside local/test/ci — it
# has no encryption at rest and no object versioning. gcs may be selected in
# any environment, including local, but needs the approval flag above.)
SOURCE_FILE_STORAGE=filesystem
SOURCE_FILE_STORAGE_DIR=.data/source-files
# Server-side quarantine limits. The client's progress bar is not authoritative.
MAX_SOURCE_FILE_BYTES=52428800
MAX_SOURCE_FILE_PAGES=300

# ── App settings ──────────────────────────────────────────────────────────
# one of: local | ci | preview | staging | production
ENVIRONMENT=local
# Max age in seconds for a Clerk session before step-up is required
STEP_UP_MAX_AGE_SECONDS=600
# Set true to bypass Clerk and use the demo stub identity (CI / local dev)
USE_STUB_IDENTITY=false
# Pipeline mock toggle (document processing phases)
USE_MOCK_PIPELINE=false

# ── Matter agent (matter-agent-service.md) ────────────────────────────────
# Off by default. While false every agent route refuses, so a partial rollout
# cannot be reached by guessing a URL.
MATTER_AGENT_ENABLED=false
MATTER_AGENT_MODEL=gemini-2.5-flash-lite
MATTER_AGENT_MAX_TOOL_CALLS=8
MATTER_AGENT_TURN_TIMEOUT_SECONDS=120

# ── Supermemory (optional, non-authoritative) ─────────────────────────────
# Neon is authoritative for the chat transcript. Supermemory only adds
# semantic recall, so leaving this off degrades recall and blocks nothing.
SUPERMEMORY_ENABLED=false
SUPERMEMORY_API_KEY=
SUPERMEMORY_BASE_URL=
# Required for tenant isolation when enabled: the container tag is an HMAC.
SUPERMEMORY_CONTAINER_HMAC_KEY=
# External-data-transfer gate. Flip only once residency, retention, deletion,
# DPA and security approval are recorded (memory-service.md §11.2).
SUPERMEMORY_REAL_DATA_APPROVED=false
